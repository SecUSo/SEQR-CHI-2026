<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/darkgrey</item>
        <item name="colorIcons">@color/colorAccent</item>
        <item name="colorGeneratorIcons">?attr/colorIcons</item>
        <item name="colorHistoryIconBackground">@color/middledarkgrey</item>
        <item name="colorHistoryIcons">?attr/colorIcons</item>
        <item name="colorHighlight">@color/highlight_transparent_light</item>
        <item name="colorSelectableItemHighlight">@color/highlight_selectable_transparent_light</item>
        <item name="colorNavbarHeaderBackground">@color/darkgrey</item>
        <item name="colorNavbarHeaderText">@color/colorAccent</item>
        <item name="colorURLHighlight">@color/white</item>
        <item name="secusoLogoDrawable">@drawable/secuso_logo_white</item>
        <item name="colorHostClassificationGrey">@color/url_classification_grey_case</item>
        <item name="colorHostClassificationBlue">@color/url_classification_blue_case</item>
        <item name="colorHostClassificationGreen">@color/url_classification_green_case</item>
        <item name="colorURLDialogBackground">@color/black</item>
        <item name="colorURLDialogIcon">@color/white</item>
        <item name="materialAlertDialogTheme">@style/AppTheme.CustomMaterialDialog</item>
    </style>

    <style name="AppTheme.URLDialog.Text" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textSize">@dimen/url_dialog_text_size</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="AppTheme.URLDialog.UrlButton" parent="Widget.AppCompat.Button">
        <item name="android:textSize">@dimen/url_dialog_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAppearance">@style/AppTheme.URLDialog.Text</item>
    </style>

    <style name="AppTheme.URLDialog.OpenWebsiteButton" parent="Widget.AppCompat.Button">
        <item name="android:textSize">@dimen/url_dialog_text_size</item>
        <item name="backgroundTint">@color/url_classification_grey_case</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAlignment">textStart</item>
        <item name="android:textColor">@color/url_classification_grey_case_button_text</item>
    </style>

    <style name="AppTheme.CustomMaterialDialog" parent="@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">?attr/colorAccent</item>
    </style>

    <style name="AppTheme.NavigationView" parent="Widget.MaterialComponents.NavigationView">
        <item name="android:background">#131212</item>
        <item name="itemTextColor">?attr/colorOnBackground</item>
        <item name="itemIconTint">?attr/colorOnBackground</item>
        <item name="itemShapeFillColor">?attr/colorSelectableItemHighlight</item>
    </style>

    <style name="AppTheme.Generator.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="colorPrimary">?attr/colorAccent</item>
        <item name="android:textColorHint">@color/lightgrey</item>
        <item name="theme">@style/AppTheme.Generator.TextInputLayout</item>
    </style>

    <style name="AppTheme.Generator.TextInputLayout.Dense" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="colorPrimary">?attr/colorAccent</item>
        <item name="android:textColorHint">@color/lightgrey</item>
        <item name="theme">@style/AppTheme.Generator.TextInputLayout</item>
    </style>
</resources>
